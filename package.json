{
  "name": "chat-engine",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./standalone": "./dist/avaya-chat-engine.min.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:lib": "vite build",
    "build:standalone": "vite build --mode standalone",
    "build": "npm run build:lib && npm run build:standalone",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@avaya/infinity-omni-sdk-core": "^1.0.5",
    "@avaya/infinity-omni-sdk-messaging": "^1.0.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^3.9.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  }
}